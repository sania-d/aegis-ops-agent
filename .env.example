# Copy to `.env` for local development. NEVER commit `.env` or real secrets!
AEGIS_ENV=local
GOOGLE_CLOUD_PROJECT=sandaw-project-2121
GOOGLE_CLOUD_LOCATION=us-central1
AEGIS_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Strategic Model Routing tiers
AEGIS_FAST_MODEL=gemini-2.5-flash
AEGIS_REASONING_MODEL=gemini-2.5-pro
AEGIS_JUDGE_MODEL=gemini-2.5-flash

# Persistent local session & memory fallbacks (Managed Agent Runtime uses Vertex AI automatically)
AEGIS_SESSION_DB_URL=sqlite+aiosqlite:///./.aegis_state/sessions.db
AEGIS_MEMORY_DB_PATH=./.aegis_state/incident_memory.db

# Optional Managed Vertex AI resources (populated by Terraform / deploy)
# AGENT_ENGINE_ID=
# VERTEX_SEARCH_DATASTORE_ID=
# AEGIS_MODEL_ARMOR_TEMPLATE=projects/sandaw-project-2121/locations/us-central1/templates/aegis-guardrail
# LOGS_BUCKET_NAME=

# Security & Policy Controls
AEGIS_DLP_ENABLED=false
AEGIS_CHANGE_FREEZE_ACTIVE=false
AEGIS_OTEL_ENABLED=true
AEGIS_LOG_LEVEL=INFO

# Secret Manager secret IDs ONLY (secret values are fetched from GCP Secret Manager)
AEGIS_PAGERDUTY_SECRET_ID=aegis-ops-agent-pagerduty-token
AEGIS_SLACK_WEBHOOK_SECRET_ID=aegis-ops-agent-slack-webhook
